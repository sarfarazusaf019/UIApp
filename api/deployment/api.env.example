# Copy to docker/api.env (git-ignored) and fill in.
Database__AuthenticationMode=Iam
AuroraPostgreSql__Host=<aurora-endpoint>
AuroraPostgreSql__Port=5432
AuroraPostgreSql__Database=<database>
AuroraPostgreSql__DbUser=<iam-enabled-db-user>
AuroraPostgreSql__Region=<aws-region>
# Local docker only: the profile in the mounted ~/.aws folder. In AWS leave it out: the attached role is used.
AuroraPostgreSql__AwsProfile=<aws-profile-name>
