{
  "Database": {
    "AuthenticationMode": "Iam"
  },
  "AuroraPostgreSql": {
    "Host": "<aurora-endpoint>",
    "Port": 5432,
    "Database": "<database>",
    "DbUser": "<iam-enabled-db-user>",
    "Region": "<aws-region>",
    "UseSsl": true
  },
  "ConnectionStrings": {
    "ClaimSelection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
