<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><LangVersion>preview</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TH.Common.AuroraPostgreSql/TH.Common.AuroraPostgreSql.csproj"/>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66"/>
    <PackageReference Include="Npgsql" Version="10.0.3"/>
  </ItemGroup>
  <ItemGroup>
    <!-- local developer settings (may hold credentials) are never part of a published / deployed build -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Remote.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
