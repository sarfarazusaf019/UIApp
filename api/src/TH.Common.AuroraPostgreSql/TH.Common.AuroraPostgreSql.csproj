<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TH.Common.AuroraPostgreSql</RootNamespace>
    <AssemblyName>TH.Common.AuroraPostgreSql</AssemblyName>
    <Description>Common library: Npgsql connections to AWS Aurora PostgreSQL with IAM database authentication.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.Core" Version="4.0.102.8" />
    <PackageReference Include="AWSSDK.RDS" Version="4.0.105.3" />
    <PackageReference Include="AWSSDK.Signin" Version="4.0.101.12" />
    <PackageReference Include="AWSSDK.SSO" Version="4.0.100.17" />
    <PackageReference Include="AWSSDK.SSOOIDC" Version="4.0.100.16" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Polly" Version="8.8.0" />
  </ItemGroup>

</Project>
